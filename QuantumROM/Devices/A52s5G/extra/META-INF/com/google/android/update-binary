#!/sbin/sh
# Dynamic Partition Installer for Samsung Devices

OUTFD=$2
ZIPFILE=$3

ui_print() {
    echo -e "ui_print $1\nui_print" > /proc/self/fd/$OUTFD
}

ui_print "==========================================="
ui_print "          Universal ROM Installer          "
ui_print "             By @Zinefather                "
ui_print "          Target: One UI 6.1               "
ui_print "==========================================="
sleep 1

TMPDIR="/tmp/rom_installer"
mkdir -p $TMPDIR
ui_print "[*] Extracting ROM zip package..."
unzip -o "$ZIPFILE" -d $TMPDIR > /dev/null 2>&1

get_block() {
    PART_NAME=$1
    if [ -b "/dev/block/mapper/$PART_NAME" ]; then
        echo "/dev/block/mapper/$PART_NAME"
    elif [ -b "/dev/block/by-name/$PART_NAME" ]; then
        echo "/dev/block/by-name/$PART_NAME"
    elif [ -b "/dev/block/bootdevice/by-name/$PART_NAME" ]; then
        echo "/dev/block/bootdevice/by-name/$PART_NAME"
    else
        echo ""
    fi
}

# 1. Flash System Image (مع عرض المميزات أثناء التفليش)
SYS_BLOCK=$(get_block "system")
if [ -f "$TMPDIR/system.img" ] && [ -n "$SYS_BLOCK" ]; then
    ui_print "[*] Flashing System Image..."
    ui_print " "
    
    # تشغيل عملية تفليش النظام في الخلفية
    dd if="$TMPDIR/system.img" of="$SYS_BLOCK" bs=4M status=none &
    DD_PID=$!

    ui_print " Dynamic System Features & Highlights:"
    ui_print "-------------------------------------------"
    
    features=(
        " • Galaxy AI Features Enabled"
        " • Adaptive Battery Optimizations"
        " • Secure Folder Patch Included"
        " • Chinese Smart Manager Support"
        " • HighEnd Animations Enabled"
        " • Samsung Custom Features Included"
        " • Native Call Recording Support"
        " • Screenshot & Screen Recording Everywhere"
        " • EXT4 / EROFS Fast File System Optimization"
        " • Performance & Thermal Management Tuning"
        " • Advanced RAM & Power Optimizations"
        " • Cleaned, Debloated & Light System"
    )

    # عرض المميزات سطر سطر أثناء استمرار عملية التفليش
    for feature in "${features[@]}"; do
        if kill -0 $DD_PID 2>/dev/null; then
            ui_print "$feature"
            sleep 2.5
        else
            break
        fi
    done

    # الانتظار حتى اكتمال عملية التفليش تماماً
    wait $DD_PID
    STATUS=$?

    if [ $STATUS -eq 0 ]; then
        ui_print "-------------------------------------------"
        ui_print "[+] System Image Flashed Successfully!"
    else
        ui_print "[-] Error: Flashing System Image Failed!"
        exit 1
    fi
else
    ui_print "[-] Error: system.img or system partition missing!"
    exit 1
fi

# 2. Flash Product Image
PROD_BLOCK=$(get_block "product")
if [ -f "$TMPDIR/product.img" ] && [ -n "$PROD_BLOCK" ]; then
    ui_print " "
    ui_print "[*] Flashing Product Image..."
    dd if="$TMPDIR/product.img" of="$PROD_BLOCK" bs=4M status=none
    ui_print "[+] Product Image Flashed Successfully!"
else
    ui_print "[-] Error: product.img or product partition missing!"
    exit 1
fi

# Cleanup
rm -rf $TMPDIR

ui_print "==========================================="
ui_print "        FLASHING COMPLETE!                 "
ui_print "                                           "
ui_print "  IMPORTANT: FORMAT DATA NOW IN TWRP!     "
ui_print "  (Wipe -> Format Data -> type 'yes')     "
ui_print "  Then Reboot System.                      "
ui_print "==========================================="
exit 0
